# Paseo environment template.
# Copy to .env (`cp .env.example .env`) and fill in values.
# Empty values (KEY=) are treated as unset. Schema: src/lib/env.ts

# -----------------------------------------------------------------------------
# Database (required)
# -----------------------------------------------------------------------------
POSTGRES_URL=postgresql://dev_user:dev_password@localhost:5432/postgres_dev

# -----------------------------------------------------------------------------
# Authentication - BetterAuth (required)
# -----------------------------------------------------------------------------
# Must be at least 32 characters. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-generated-secret-of-32-plus-chars

# Google OAuth (optional - enables "Sign in with Google")
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# App URL
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# OpenAI - LlmPort adapter (optional; without it the agent cannot reply)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
# Model id override. Leave empty to use the adapter's default.
OPENAI_MODEL=

# -----------------------------------------------------------------------------
# Flight provider
# -----------------------------------------------------------------------------
# "duffel" (real fares) or "fixtures" (deterministic fake data for local dev).
# "fixtures" is refused when NODE_ENV=production.
FLIGHT_PROVIDER=fixtures

# Duffel access token (https://app.duffel.com -> Developers -> Access tokens).
# Test tokens (duffel_test_...) return sandbox data only - not real fares.
# Live tokens (duffel_live_...) are required for real, bookable prices.
DUFFEL_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Google Places (optional - place details for destinations)
# -----------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=

# -----------------------------------------------------------------------------
# Vercel Cron (optional locally; required in production for /api/cron/*)
# -----------------------------------------------------------------------------
# Random string; Vercel sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# -----------------------------------------------------------------------------
# File storage (optional - empty uses local public/uploads/)
# -----------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=

# -----------------------------------------------------------------------------
# Limits (optional - defaults shown; positive integers)
# CANDIDATE_LIMIT must be <= MAX_SEARCHES_PER_RUN.
# -----------------------------------------------------------------------------
CANDIDATE_LIMIT=10
MAX_SEARCHES_PER_RUN=15
SEARCH_CONCURRENCY=4
MAX_CLARIFICATIONS=3
DEFAULT_TIMEFRAME_DAYS=30
ANON_RETENTION_DAYS=30
OFFER_STALE_MINUTES=30
FLIGHT_CACHE_TTL_MINUTES=10

# -----------------------------------------------------------------------------
# Reserved - not read yet; defaults are set in chunk E (abuse caps) and
# chunk G (search timeouts). Do not rely on these until those chunks land.
# -----------------------------------------------------------------------------
# SEARCH_TIMEOUT_MS=
# SEARCH_WALL_CLOCK_MS=
# DAILY_MESSAGE_CAP=
# DAILY_SEARCH_CAP=
# GLOBAL_KILL_SWITCH=
